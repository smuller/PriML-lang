priority High
priority Med
priority Low

order Low < Med
order Med < High

(* constraint violation {Med} <= {High, Med} *)
main {

    t <- spawn[if true then High else Med] {
        ret 1
    };

    spawn[High] {
        change[if true then Low else Low];
        change[High];
        x <- sync t;
        ret x
    }
}
