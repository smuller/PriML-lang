priority A
priority B

(* CORRECT compiles *)
main {
    (* A simple change command *)
    change[if true then A else B];
    change[bot];
    
    (* recognize that bot is lower than both A and B *)
    td <- spawn[if true then A else B] { ret 2 };
    sync td;
    
    (* more complex commands with binding *)
    t <- 
        let val m = cmd { 
            change[A];
            change[if true then B else A];
            ret 1 
        }
        in
            spawn[if true then A else B] { m }
        end;

    t' <- spawn[A] { ret 2 };

    x <- sync t;
    ret x

}

