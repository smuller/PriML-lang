priority A
priority B
priority C

order A < C
order B < C


fun join p1 p2 : prio[p | p1 <= p and p2 <= p] =
  (if p1 <== A andalso p2 <== A andalso A <== p1 andalso A <== p2 then (A : prio[p | p1 <= p and p2 <= p])
  else if p1 <== B andalso p2 <== B andalso B <== p1 andalso B <== p2 then (B : prio[p | p1 <= p and p2 <= p])
  else (C : prio[p | p1 <= p and p2 <= p])) (*: prio[p | p1 <= p and p2 <= p and p <= A ]*)

main {
  ret (join A A, join A B, join B A)
}
