fun fib p n =
    if n < 2 then 
        cmd { ret n }
    else
        cmd { 
            x_thread <- spawn[p] {
                x <- fib p (n - 2); 
                ret x
            };
            y <- fib p (n - 1);
            x <- sync x_thread;
            ret (x + y)
        }

fun spawnfib n =
    (* if n < 15 then
        cmd { 
            t <- spawn[smallfib] { fib smallfib n };
            ret 5
        }
    else *)
        cmd { 
            t <- spawn[bigfib] { fib bigfib n };
            ret 5
        }

main {
    spawnfib 42
    
}
